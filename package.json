{
  "name": "commitpick-cli",
  "version": "0.4.1",
  "description": "Generate and pick concise bilingual Conventional Commit messages from Git changes.",
  "type": "module",
  "bin": {
    "cmsg": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "conventional-commits",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhuakawaii/commitpick-cli.git"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
